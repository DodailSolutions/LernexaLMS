# General Setup
NODE_ENV=development
NEXTAUTH_SECRET=32_byte_secret_hash_key_value
NEXTAUTH_URL=http://localhost:3000

# Database Settings (MySQL 8.0)
DATABASE_URL="mysql://root:rootpassword@localhost:3306/lernexa"

# Licensing Platform Configuration
LICENSE_API_URL=https://licensing.lernexa.com/api/v1
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAv16s...=="

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Storage Configurations (AWS S3 or Cloudflare R2)
STORAGE_PROVIDER=local # options: local, s3, r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


